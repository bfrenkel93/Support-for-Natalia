# ------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# In Vercel, add these same variables under Project Settings -> Environment Variables.
# ------------------------------------------------------------------

# --- Supabase (required to store & lock in sign-ups) ---
# Found in Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SERVICE ROLE key. Keep this SECRET. It is only ever used on the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin login (required for the /admin page) ---
# Pick any password you like. You'll type this to reach the admin dashboard.
ADMIN_PASSWORD=change-me-to-something-only-you-know

# --- Email notifications (optional but recommended) ---
# Sign up free at https://resend.com and create an API key.
RESEND_API_KEY=
# Where sign-up notifications are sent (probably your own email).
NOTIFY_EMAIL=brookefrenkel@gmail.com
# Optional: also notify Natalia when a new memory is shared (link only, never
# the media). Leave blank to skip.
NATALIA_EMAIL=
# The "from" address. Until you verify your own domain in Resend,
# you can use their shared testing address below.
RESEND_FROM="Support for Natalia <onboarding@resend.dev>"

# --- Site URL (optional) ---
# Used to build the secure link inside memory-notification emails. On Vercel
# this is auto-detected from the request, so you usually don't need to set it.
SITE_URL=

# --- Weekend Ideas: automated Boston events (optional) ---
# Free key from https://developer.ticketmaster.com (Discovery API). Without it,
# the "Things to Do Together" section still works from the curated evergreen
# list — this just adds dated special events (Red Sox, family shows, festivals).
TICKETMASTER_API_KEY=
# Protects the weekly refresh endpoint. Set any long random string; Vercel Cron
# sends it automatically. Required for the cron job to run.
CRON_SECRET=
